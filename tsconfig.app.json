{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["@rsbuild/core/types"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "monaco-editor/editor/editor.api": [
        "./node_modules/monaco-editor/esm/vs/editor/editor.api"
      ],
      "monaco-editor/languages/definitions/markdown/register.js": [
        "./node_modules/monaco-editor/esm/vs/languages/definitions/markdown/register"
      ],
      "monaco-editor/editor/editor.worker": [
        "./node_modules/monaco-editor/esm/vs/editor/editor.worker.js"
      ]
    }
  },
  "include": ["src"]
}
